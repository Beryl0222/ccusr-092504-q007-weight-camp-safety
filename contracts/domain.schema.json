{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "减重训练安全干预台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ASSESSMENT_APPROVED",
        "PLAN_ACTIVATED",
        "PRESCRIPTION_UPDATED",
        "SESSION_RECORDED",
        "TRAINING_STOPPED",
        "ESCALATION_RAISED",
        "TRAINING_RESUMED",
        "REFUND_SETTLED",
        "FOLLOWUP_CLOSED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "participant",
        "risk_assessment",
        "training_plan",
        "safety_incident",
        "refund_settlement"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
